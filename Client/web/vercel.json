{
  "cleanUrls": true,
  "headers": [
    { "source": "/(.*)", "headers": [ { "key": "X-Robots-Tag", "value": "noindex, nofollow" }, { "key": "X-Content-Type-Options", "value": "nosniff" } ] },
    { "source": "/(.*)\\.(wasm|dat|dll|blat)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=3600" } ] }
  ]
}
